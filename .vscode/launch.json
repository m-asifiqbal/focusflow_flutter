{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FocusFlow",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "FocusFlow (Google Drive)",
      "request": "launch",
