    {
      "name": "FocusFlow (profile, Google Drive)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=config/google.json"]
    }
  ]
}
